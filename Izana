-- ===== BUILD SPAM MESSAGE (100 @ DIRECTLY IN FRONT OF PRESET) =====
local presetIndex = 1

local function buildRageMessage()
	local sym = symbolBox.Text ~= "" and symbolBox.Text or "@"
	local target = targetBox.Text ~= "" and targetBox.Text or "[Fuck Hater]"
	local rawCount = tonumber(countBox.Text) or 100
	local count = math.clamp(math.floor(rawCount), 1, 500)

	local prefixSymbols = string.rep(sym, count)
	local rawPreset = ragePresets[presetIndex] or ragePresets[1]

	presetIndex = presetIndex + 1
	if presetIndex > #ragePresets then
		presetIndex = 1
	end

	local formattedPreset = rawPreset:gsub("%[TARGET%]", target):gsub("%[Target%]", target)
	return prefixSymbols .. formattedPreset
end

