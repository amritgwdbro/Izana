-- ===== CHAT SEND FUNCTION =====
local function sendChat(msg)
	if not msg or msg == "" then return end
	pcall(function()
		local textChannels = TextChatService:FindFirstChild("TextChannels")
		local general = textChannels and textChannels:FindFirstChild("RBXGeneral")
		if general and general.SendAsync then
			general:SendAsync(msg)
			return
		end
	end)
	pcall(function()
		local sayReq = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
		if sayReq then
			sayReq:FireServer(msg, "All")
		end
	end)
end

-- ===== RGB RP NAME & BIO SYSTEM =====
local function getCurrentRGBColor()
	local hue = (tick() * 0.35) % 1
	return Color3.fromHSV(hue, 1, 1)
end

local function fireRPRemotes(rgbColor)
	pcall(function()
		for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
			if desc:IsA("RemoteEvent") then
				local n = desc.Name:lower()
				if n:find("rpname") or n:find("setname") or n:find("name") then
					pcall(function()
						desc:FireServer(RP_NAME, rgbColor)
					end)
				elseif n:find("rpbio") or n:find("setbio") or n:find("bio") then
					pcall(function()
						desc:FireServer(RP_BIO, rgbColor)
					end)
				elseif n:find("rpcolor") or n:find("color") then
					pcall(function()
						desc:FireServer(rgbColor)
					end)
				end
			end
		end
	end)
end

