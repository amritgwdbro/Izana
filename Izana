	creditLbl.TextColor3 = t.accent

	rgbRpBtn.BackgroundColor3 = t.card
	rgbRpBtn.TextColor3 = rgbRpEnabled and t.accent or t.subText
	rgbRpBtn.Text = rgbRpEnabled and "🌈 RGB RP: ON" or "🌈 RGB RP: OFF"
	rgbRpStroke.Color = t.accent

	themeBtn.BackgroundColor3 = t.card
	themeBtn.TextColor3 = t.text
	themeBtn.Text = "🎨 " .. t.name
	themeBtnStroke.Color = t.accent

	minBtn.BackgroundColor3 = t.card
	minBtn.TextColor3 = t.text
	minBtnStroke.Color = t.accent

	for _, lbl in ipairs({targetLbl, symbolLbl, countLbl, speedLbl}) do
		lbl.TextColor3 = t.text
	end

	for _, holder in ipairs({targetHolder, symbolHolder, countHolder, speedHolder}) do
		holder.BackgroundColor3 = t.card
	end

	for _, stroke in ipairs({targetStroke, symbolStroke, countStroke, speedStroke}) do
		stroke.Color = t.accent
	end

	for _, box in ipairs({targetBox, symbolBox, countBox, speedBox}) do
		box.TextColor3 = t.text
	end

	if running then
		startBtn.BackgroundColor3 = Color3.fromRGB(200, 35, 55)
		startBtn.Text = "■ STOP"
	else
		startBtn.BackgroundColor3 = t.btn
		startBtn.Text = "▶ START"
	end
	startStroke.Color = t.accent
end

